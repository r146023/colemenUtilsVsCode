{
	"name": "colemenutils",
	"displayName": "ColemenUtils",
	"description": "Comprehensive utility extension for text formatting and productivity",
	"publisher": "colemen",
	"version": "0.0.13",
	"target": "es2020",
	"lib":["es2020"],
	"module": "commonjs",
	"moduleResolution": "node",
	"repository": {
		"type": "git",
		"url": "https://github.com/r146023/colemenUtilsVsCode.git"},
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [
		"*",
		"onCommand:colemenutils.helloWorld",
		"onView:myext-todos-view"
	],
	"main": "./extension.js",
	"contributes": {
