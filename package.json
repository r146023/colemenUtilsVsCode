		"keybindings": [
			{
				"key": "ctrl+shift+b",
				"command": "colemenutils.toggleBlockQuote",
				"when": "editorLangId == 'markdown' && editorTextFocus"
			},
			{
				"key": "shift+delete",
				"command": "colemenutils.deleteCurrentLine",
				"when": "editorTextFocus && (isWindows || isLinux)"
			},
			{
				"key": "ctrl+tab",
				"command": "colemenutils.indentSelectedLines",
				"when": "editorTextFocus && (isWindows || isLinux)"
			},
			{
				"key": "ctrl+shift+delete",
				"command": "colemenutils.cutCurrentLine",
				"when": "editorTextFocus && (isWindows || isLinux)"
			},
			{
				"key": "alt+c",
				"command": "colemenutils.copyCurrentLine",
				"when": "editorTextFocus && (isWindows || isLinux)"
			},
			{
				"key": "ctrl+alt+x",
				"command": "colemenutils.stripTrailingSpaces",
				"when": "editorTextFocus && (isWindows || isLinux)"
			},
			{
				"key": "ctrl+b",
				"command": "editor.action.insertSnippet",
				"when": "editorLangId == 'markdown' && editorTextFocus",
				"args": {
					"snippet": "**${TM_SELECTED_TEXT:$0}**"
				}
			},
			{
				"key": "ctrl+i",
				"command": "editor.action.insertSnippet",
				"when": "editorLangId == 'markdown' && editorTextFocus",
				"args": {
					"snippet": "*${TM_SELECTED_TEXT:$0}*"
				}
			},
			{
				"key": "ctrl+up",
				"command": "colemenutils.addMarkdownHeader",
				"when": "editorLangId == 'markdown' && editorTextFocus"
			},
			{
				"key": "ctrl+down",
				"command": "colemenutils.removeMarkdownHeader",
				"when": "editorLangId == 'markdown' && editorTextFocus"
			},
			{
				"key": "alt+shift+i",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.selectHighlights",
						"notebook.selectAllFindMatches"
					]
				}
			},
			{
				"key": "ctrl+l",
				"command": "colemenutils.selectCurrentLine",
				"when": "editorTextFocus"
			},
			{
				"key": "alt+shift+tab",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.previousSelectionMatchFindAction"
					]
				}
			},

			{
				"key": "ctrl+shift+down",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.moveLinesDownAction"
					]
				}
			},
			{
				"key": "ctrl+shift+up",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.moveLinesUpAction"
					]
				}
			},
			{
				"key": "alt+shift+u",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.transformToUppercase"
					]
				}
			},
			{
				"key": "ctrl+u",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.transformToLowercase"
					]
				}
			},
			{
				"key": "ctrl+q",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.commentLine"
					]
				}
			},
			{
				"key": "alt+0",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.foldAll"
					]
				}
			},
			{
				"key": "shift+alt+0",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.unfoldAll"
					]
				}
			},
			{
				"key": "shift+alt+x",
				"command": "colemenutils.insertBoxHeader",
				"when": "editorTextFocus"
			},
			{
				"key": "alt+x",
				"command": "colemenutils.insertSingleLineHeader",
				"when": "editorTextFocus"
			},
			{
				"key": "ctrl+d",
				"command": "runCommands",
				"args": {
					"commands": [
						"editor.action.duplicateSelection"
					]
				}
			}
		],
		"configuration": [
			{
				"title": "ColemenUtils JSON",
				"properties": {
					"colemenutils.json.indentSize": {
						"type": "number",
						"default": 2,
						"description": "Number of spaces for JSON indentation"
					}
				}
			},
			{
				"title": "Colemen Utils Mstep Highlighting",
				"properties": {
					"colemenutils.mstepHighlighting.tagColors": {
					"type": "object",
					"default": {
						"EVENT": [null, "#b488ff6e"],
						"IF": ["#e4f3a0", "#4e5a18"],
						"LOOP": ["#d0bfff", "#4e2c85"],
						"ELSE": ["#adb5bd", "#6c757d"],
						"RETURN": ["#dd7db2", "#701e4b"],
						"EVENT-CLICK": ["#5b97af", "#1f5a72"],
						"": ["#c09cff", "#6e42c171"]
					},
					"description": "Map of Mstep tag -> [foregroundColor, backgroundColor]. Foreground can be null to use editor default. Keys are case-insensitive at runtime.",
					"additionalProperties": {
						"anyOf": [
						{
							"type": "array",
							"minItems": 2,
							"maxItems": 2,
							"items": [
							{
								"anyOf": [
								{ "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
								{ "type": "null" }
								],
								"description": "Foreground color"
							},
							{
								"type": "string",
								"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
								"description": "Background color"
							}
							]
						},
						{
							"type": "object",
							"required": ["bg"],
							"properties": {
							"fg": {
								"anyOf": [
								{ "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
								{ "type": "null" }
								],
								"description": "Foreground color"
							},
							"bg": {
								"type": "string",
								"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
								"description": "Background color"
							}
							},
							"additionalProperties": false,
							"description": "Alternative object form: { fg, bg }"
						}
						]
					}
					}
				}
			},
			{
				"title": "Todo Highlighting",
				"properties": {
					"colemenutils.todoCodeLens.enabled": {
						"type": "boolean",
						"default": true,
						"description": "Enable TODO/FIXME CodeLens and highlighting."
					},
					"colemenutils.todoCodeLens.highlightBackground": {
						"type": "string",
						"format": "color",
						"default": "#441a34",
						"description": "Background color for the full-line TODO highlight (CSS color or hex). `colemenutils.todoCodeLens.highlightBackground`"
					},
					"colemenutils.todoCodeLens.fontColor": {
						"type": "string",
						"format": "color",
						"default": "#e78de3e6",
						"description": "The font color of the todo (CSS color or hex). `colemenutils.todoCodeLens.fontColor`"
					},
					"colemenutils.todoCodeLens.underlineEnabled": {
						"type": "boolean",
						"default": true,
						"description": "If the todo should be underlined. `colemenutils.todoCodeLens.underlineEnabled`"
					},
					"colemenutils.todoCodeLens.underlineColor": {
						"type": "string",
						"format": "color",
						"default": "#ff00f2",
						"description": "Underline color used for TODO highlight (CSS color). `colemenutils.todoCodeLens.underlineColor`"
					},
					"colemenutils.todoCodeLens.isWholeLine": {
						"type": "boolean",
						"default": true,
						"description": "Apply the TODO highlight as a whole-line decoration. `colemenutils.todoCodeLens.isWholeLine`"
					}
				}
			},
			{
				"title": "Auto Rename Tag Settings",
				"properties": {
					"colemenutils.autoRenameTag.enabled": {
						"type": "boolean",
						"default": true,
						"description": "Enable automatic tag renaming"
					},
					"colemenutils.autoRenameTag.delay": {
						"type": "number",
						"default": 100,
						"description": "Delay in milliseconds before auto-renaming (debounce)"
					}
				}
			},
			{
				"title": "ColemenUtils Lines to String Array",
				"properties": {
